# Application Settings
PROJECT_NAME="TechTrend Monitor & Sentiment Dashboard"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security (Generate a secure 32+ character random string in production)
SECRET_KEY="super-secret-production-key-change-me-1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./tech_monitor.db"
# Docker / Production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/tech_monitor"

# Background Worker & Aggregation
SYNC_INTERVAL_SECONDS=180
MAX_FEED_ITEMS=30
HACKER_NEWS_API_BASE="https://hacker-news.firebaseio.com/v0"
